@page "/"
@implements IDisposable
@inject MobileAppState State
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Билеты ГИБДД AB</PageTitle>

@if (!State.IsInitialized)
{
    <section class="center-state"><div class="spinner"></div><p>@State.InitializationStatus</p></section>
}
else if (!string.IsNullOrWhiteSpace(State.InitializationError))
{
    <section class="notice error"><h1>Не удалось запустить приложение</h1><p>@State.InitializationError</p></section>
}
else if (State.NeedsPairing)
{
    <section class="auth-card pairing-card">
        <img src="logo.png" alt="Логотип" />
        <span class="eyebrow">ОДИН РАЗ</span>
        <h1>Синхронизация с компьютером</h1>
        <p>Нажмите кнопку ниже и отсканируйте QR-код, показанный на экране компьютера. Это нужно сделать только один раз.</p>
        <button class="primary wide camera-button" disabled="@busy" @onclick="ScanAsync">Открыть камеру</button>
        <button class="text-button wide" @onclick="ToggleCode">@(!showCode ? "Ввести короткий код вручную" : "Скрыть ввод кода")</button>
        @if (showCode)
        {
            <label class="field-label" for="pair-code">Одноразовый код с экрана компьютера</label>
            <input id="pair-code" inputmode="text" maxlength="11" autocomplete="one-time-code" @bind="shortCode" />
            <button class="secondary wide" disabled="@busy" @onclick="PairCodeAsync">Связать устройства</button>
        }
        <button class="text-button wide" @onclick="State.SkipPairingAsync">Продолжить пока без компьютера</button>
        @if (!string.IsNullOrWhiteSpace(State.PairingStatus))
        {
            <p class="status-note">@State.PairingStatus</p>
        }
    </section>
}
else
{
    <section class="hero-card compact">
        <span class="eyebrow">ЭКЗАМЕН</span>
        <h1>20 вопросов · 20 минут</h1>
        <p>Четыре тематических блока. Сложные вопросы подбираются с учётом прошлых ошибок.</p>
        <label class="field-label" for="candidate">Имя кандидата на этом устройстве</label>
        <input id="candidate" maxlength="100" @bind="candidateName" />
        <button class="primary wide" disabled="@busy" @onclick="StartExamAsync">Начать экзамен</button>
    </section>

    @if (State.ActiveSession is { IsCompleted: false })
    {
        <section class="resume-card">
            <div><strong>Текущая сессия сохранена</strong><span>@State.ActiveSession.StageCaption · вопрос @(State.ActiveSession.CurrentIndex + 1)</span></div>
            <button class="secondary" @onclick="ResumeActive">Вернуться</button>
        </section>
    }
    else if (State.SavedDraft is not null)
    {
        <section class="resume-card">
            <div><strong>Незавершённая сессия</strong><span>@DraftCaption(State.SavedDraft)</span></div>
            <div class="button-row">
                <button class="secondary" @onclick="ResumeAsync">Продолжить</button>
                <button class="text-button danger" @onclick="State.DiscardDraftAsync">Удалить</button>
            </div>
        </section>
    }

    <section class="metric-grid">
        <article><span>Сессии</span><strong>@State.SessionCount</strong></article>
        <article><span>Точность</span><strong>@State.AccuracyPercent.ToString("0")%</strong></article>
        <article><span>Сдано</span><strong>@State.PassedExamCount</strong></article>
    </section>

    <section class="section-card connection-card">
        <div class="section-heading">
            <div><span class="eyebrow">СВЯЗЬ УСТРОЙСТВ</span><h2>@State.AccountCaption</h2></div>
            <span class="pill">@(State.IsLinked ? "Синхронизировано" : "Локально")</span>
        </div>
        <p>@(State.IsLinked ? "Ошибки и результаты переносятся автоматически." : "Подключите компьютер, чтобы объединить историю без регистрации.")</p>
        @if (!State.IsLinked && State.IsCloudConfigured)
        {
            <button class="secondary wide" disabled="@busy" @onclick="ScanAsync">Подключить компьютер</button>
        }
        <h3>Подключённые устройства</h3>
        <p class="status-note">@State.ConnectedDevicesStatus</p>
        <div class="device-list">
            @foreach (var device in State.ConnectedDevices)
            {
                <article class="device-row">
                    <div>
                        <strong>@DeviceKindCaption(device.DeviceKind)@(device.IsCurrentDevice ? " · это устройство" : string.Empty)</strong>
                        <span>@device.DeviceName · @LastSeenCaption(device.LastSeenAtUtc)</span>
                    </div>
                    <button class="text-button danger" @onclick="() => RevokeDeviceAsync(device.DeviceId)">
                        @(device.IsCurrentDevice ? "Отвязать это устройство" : "Отвязать устройство")
                    </button>
                </article>
            }
        </div>
        <div class="button-row">
            <button class="text-button" @onclick="async () => await State.RefreshConnectedDevicesAsync()">Обновить список</button>
            <button class="text-button danger" @onclick="ResetSynchronizationAsync">Сбросить синхронизацию</button>
        </div>
        <button class="text-button wide" @onclick="State.ConnectTelegramAsync">Подключить Telegram</button>
    </section>

    <section class="section-card">
        <div class="section-heading"><div><span class="eyebrow">ОФЛАЙН</span><h2>Вопросы без сети</h2></div><span class="pill">@State.OfflineImageCount / 548 фото</span></div>
        @if (State.ImagesAreBundled)
        {
            <p>Все 800 вопросов и 548 JPEG-изображений уже находятся внутри APK и доступны без сети.</p>
        }
        else
        {
            <p>Тексты и оболочка доступны офлайн всегда. Фотографии подгружаются по мере использования или одним пакетом @State.OfflinePackageSizeCaption.</p>
        }
        @if (!State.ImagesAreBundled && State.IsOfflineDownloadRunning)
        {
            <progress value="@State.OfflineCompleted" max="@Math.Max(1, State.OfflineTotal)"></progress>
            <small>@State.OfflineCompleted из @State.OfflineTotal</small>
            <button class="text-button danger wide" @onclick="State.CancelOfflinePackageDownloadAsync">Отменить загрузку</button>
        }
        else if (!State.ImagesAreBundled)
        {
            <button class="secondary wide" @onclick="State.DownloadOfflinePackageAsync">Скачать все изображения</button>
        }
    </section>

    @if (State.SupportsInstallableUpdates)
    {
        <section class="section-card">
            <div><span class="eyebrow">ОБНОВЛЕНИЯ</span><h2>Android APK</h2></div>
            <p>Приложение проверяет опубликованные GitHub Releases. Установка начинается только после вашего подтверждения в Android.</p>
            @if (!string.IsNullOrWhiteSpace(State.UpdateStatus))
            {
                <p class="status-note">@State.UpdateStatus</p>
            }
            <div class="button-row">
                <button class="secondary" @onclick="State.CheckForUpdatesAsync">Проверить</button>
                @if (State.HasInstallableUpdate)
                {
                    <button class="primary" @onclick="State.OpenAvailableUpdateAsync">Скачать APK</button>
                }
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(localError))
    {
        <p class="inline-error">@localError</p>
    }

    @if (!string.IsNullOrWhiteSpace(State.Status))
    {
        <p class="status-note">@State.Status</p>
    }
}

@code {
    private string candidateName = "Кандидат";
    private string localError = string.Empty;
    private bool busy;
    private bool showCode;
    private string shortCode = string.Empty;

    protected override void OnInitialized() => State.Changed += OnStateChanged;

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task StartExamAsync()
    {
        busy = true;
        localError = string.Empty;
        try
        {
            await State.StartExamAsync(string.IsNullOrWhiteSpace(candidateName) ? "Кандидат" : candidateName.Trim());
            Navigation.NavigateTo("/session");
        }
        catch (Exception exception)
        {
            localError = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ResumeAsync()
    {
        if (await State.ResumeDraftAsync())
            Navigation.NavigateTo("/session");
    }

    private void ResumeActive() => Navigation.NavigateTo("/session");

    private async Task ScanAsync()
    {
        busy = true;
        try
        {
            await State.ScanAndPairAsync();
        }
        finally
        {
            busy = false;
        }
    }

    private async Task PairCodeAsync()
    {
        busy = true;
        try
        {
            if (await State.PairWithShortCodeAsync(shortCode))
                shortCode = string.Empty;
        }
        finally
        {
            busy = false;
        }
    }

    private void ToggleCode() => showCode = !showCode;

    private async Task RevokeDeviceAsync(Guid deviceId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Отвязать выбранное устройство? Его доступ к общему профилю будет отозван.");
        if (confirmed)
            await State.RevokeDeviceAsync(deviceId);
    }

    private async Task ResetSynchronizationAsync()
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Сбросить синхронизацию на этом устройстве? Локальная история останется, но потребуется новый QR-код.");
        if (confirmed)
            await State.ResetSynchronizationAsync();
    }

    private static string DeviceKindCaption(StudyDeviceKind kind) => kind switch
    {
        StudyDeviceKind.WindowsDesktop => "Компьютер",
        StudyDeviceKind.AndroidApp => "Телефон",
        _ => "Браузер"
    };

    private static string LastSeenCaption(DateTimeOffset? value) => value is null
        ? "активность неизвестна"
        : "активность " + value.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm");

    private static string DraftCaption(ActiveSessionDraft draft) => draft.Mode == StudyMode.Exam
        ? $"Экзамен · вопрос {draft.CurrentQuestionIndex + 1}"
        : $"{draft.Mode} · вопрос {draft.CurrentQuestionIndex + 1}";

    public void Dispose() => State.Changed -= OnStateChanged;
}
