@page "/login"
@inject MobileAppState State
@inject NavigationManager Navigation

<PageTitle>Вход — Билеты ГИБДД</PageTitle>

<section class="auth-card">
    <img src="logo.png" alt="Логотип" />
    <span class="eyebrow">ОБЩИЙ АККАУНТ</span>
    <h1>Вход</h1>
    <p>Регистрация отключена. Используйте выданные email и пароль.</p>
    <label class="field-label" for="email">Email</label>
    <input id="email" type="email" autocomplete="username" @bind="email" />
    <label class="field-label" for="password">Пароль</label>
    <input id="password" type="password" autocomplete="current-password" @bind="password" />
    <button class="primary wide" disabled="@busy" @onclick="SignInAsync">Войти</button>
    @if (!string.IsNullOrWhiteSpace(State.Status))
    {
        <p class="inline-error">@State.Status</p>
    }
</section>

@code {
    private string email = string.Empty;
    private string password = string.Empty;
    private bool busy;

    private async Task SignInAsync()
    {
        busy = true;
        var suppliedPassword = password;
        password = string.Empty;
        try
        {
            if (await State.SignInAsync(email, suppliedPassword))
                Navigation.NavigateTo("/");
        }
        finally
        {
            busy = false;
        }
    }
}
