@inherits LayoutComponentBase
@implements IDisposable
@inject MobileAppState State

<div class="app-shell">
    <header class="topbar">
        <img src="logo.png" alt="Логотип" />
        <div>
            <strong>Билеты ГИБДД AB</strong>
            <span>@State.DeviceCaption</span>
        </div>
    </header>

    <main class="page-content">
        @Body
    </main>

    @if (State.ActiveSession is null || State.ActiveSession.IsCompleted)
    {
        <nav class="bottom-nav" aria-label="Основная навигация">
            <NavLink href="/" Match="NavLinkMatch.All">
                <span class="nav-icon">⌂</span><span>Главная</span>
            </NavLink>
            <NavLink href="/train">
                <span class="nav-icon">✓</span><span>Учиться</span>
            </NavLink>
            <NavLink href="/progress">
                <span class="nav-icon">▥</span><span>Прогресс</span>
            </NavLink>
        </nav>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
        _ = InitializeStateAsync();
        _ = RunForegroundSyncAsync(foregroundCancellation.Token);
    }

    private readonly CancellationTokenSource foregroundCancellation = new();

    private async Task InitializeStateAsync() => await State.InitializeAsync();

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task RunForegroundSyncAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(2));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (State.IsInitialized && State.CanStudy && State.ActiveSession is null)
                    await State.SyncAsync(cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Layout was disposed.
        }
    }

    public void Dispose()
    {
        foregroundCancellation.Cancel();
        foregroundCancellation.Dispose();
        State.Changed -= OnStateChanged;
    }
}
