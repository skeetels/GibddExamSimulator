<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <DeploymentPython Condition="'$(DeploymentPython)' == ''">python</DeploymentPython>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.7" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GibddExamSimulator.Core\GibddExamSimulator.Core.csproj" />
    <ProjectReference Include="..\GibddExamSimulator.Application\GibddExamSimulator.Application.csproj" />
    <ProjectReference Include="..\GibddExamSimulator.Sync\GibddExamSimulator.Sync.csproj" />
    <ProjectReference Include="..\GibddExamSimulator.Mobile.Shared\GibddExamSimulator.Mobile.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="wwwroot/logo.png" />
    <Content Remove="wwwroot/question-bank/ab/**/*" />

    <StaticWebAsset Include="../../assets/branding/logo-master-v2.png">
      <SourceId>$(PackageId)</SourceId>
      <SourceType>Package</SourceType>
      <ContentRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)/../../assets/branding'))</ContentRoot>
      <BasePath>/</BasePath>
      <RelativePath>logo.png</RelativePath>
      <AssetKind>All</AssetKind>
      <AssetMode>All</AssetMode>
      <AssetRole>Primary</AssetRole>
      <RelatedAsset></RelatedAsset>
      <AssetTraitName></AssetTraitName>
      <AssetTraitValue></AssetTraitValue>
      <Fingerprint></Fingerprint>
      <Integrity></Integrity>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <OriginalItemSpec>../../assets/branding/logo-master-v2.png</OriginalItemSpec>
    </StaticWebAsset>

    <StaticWebAsset Include="../../assets/question-bank/ab/**/*">
      <SourceId>$(PackageId)</SourceId>
      <SourceType>Package</SourceType>
      <ContentRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)/../../assets/question-bank/ab'))</ContentRoot>
      <BasePath>/</BasePath>
      <RelativePath>question-bank/ab/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
      <AssetKind>All</AssetKind>
      <AssetMode>All</AssetMode>
      <AssetRole>Primary</AssetRole>
      <RelatedAsset></RelatedAsset>
      <AssetTraitName></AssetTraitName>
      <AssetTraitValue></AssetTraitValue>
      <Fingerprint></Fingerprint>
      <Integrity></Integrity>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <OriginalItemSpec>%(Identity)</OriginalItemSpec>
    </StaticWebAsset>
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <Target Name="ValidateProductionDeploymentConfig"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release' and '$(SkipDeploymentConfigValidation)' != 'true'">
    <Exec Command="&quot;$(DeploymentPython)&quot; &quot;$(MSBuildProjectDirectory)\..\..\tools\validate_deployment_config.py&quot; --config &quot;$(MSBuildProjectDirectory)\wwwroot\client-settings.json&quot;" />
  </Target>

</Project>
