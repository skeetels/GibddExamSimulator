<Window x:Class="GibddExamSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GibddExamSimulator.Views"
        Title="Экзамен ГИБДД — категория AB"
        Background="{StaticResource Surface}"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">
  <Grid>
    <!-- Loading -->
    <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Loading}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720">
        <Image Source="Branding/logo.png" Width="112" Height="112" Margin="0,0,0,24" />
        <TextBlock Text="Тренажёр экзамена ГИБДД" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Text="{Binding LoadingText}" Margin="0,18,0,0" Foreground="{StaticResource Muted}"
                   FontSize="18" TextWrapping="Wrap" TextAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,28,0,0" />
      </StackPanel>
    </Grid>

    <!-- One-time device pairing -->
    <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Pairing}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.2*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource Navy}" Padding="64">
        <StackPanel VerticalAlignment="Center" MaxWidth="700">
          <Image Source="Branding/logo.png" Width="128" Height="128" HorizontalAlignment="Left" />
          <TextBlock Text="Синхронизация с телефоном" Foreground="White" FontSize="40" FontWeight="SemiBold" Margin="0,28,0,12" />
          <TextBlock Text="Откройте приложение «Тренажёр экзамена ГИБДД» на телефоне и отсканируйте QR-код. Это нужно сделать только один раз."
                     Foreground="#E3EEF5" FontSize="21" TextWrapping="Wrap" LineHeight="31" />
          <TextBlock Text="После привязки результаты, ошибки и слабые темы будут переноситься автоматически."
                     Foreground="#C9DCE9" FontSize="17" TextWrapping="Wrap" Margin="0,22,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="White" Padding="48,32">
        <StackPanel VerticalAlignment="Center" MaxWidth="500" HorizontalAlignment="Center">
          <Border Width="330" Height="330" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
            <Grid>
              <TextBlock Text="Получаем QR-код…" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextWrapping="Wrap" TextAlignment="Center" />
              <Image Source="{Binding PairingQrImage}" Stretch="Uniform" />
            </Grid>
          </Border>
          <TextBlock Text="{Binding PairingStatus}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0" />
          <TextBlock Text="{Binding PairingExpires}" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0" />
          <TextBlock Text="Резервный код" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,18,0,4" />
          <TextBlock Text="{Binding PairingShortCode}" FontFamily="Consolas" FontSize="28" FontWeight="Bold" TextAlignment="Center" />
          <Button Content="Получить новый QR" Command="{Binding ConnectNewPhoneCommand}" Margin="0,18,0,0" Width="220" />
          <Button Content="Продолжить пока без телефона" Command="{Binding SkipPairingCommand}" Margin="0,10,0,0" Width="280" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Home -->
    <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Home}">
      <Grid.RowDefinitions>
        <RowDefinition Height="88" />
        <RowDefinition Height="*" />
        <RowDefinition Height="72" />
      </Grid.RowDefinitions>
      <Border Background="{StaticResource Navy}" Padding="28,12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image Source="Branding/logo.png" Width="58" Height="58" />
          <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="ЭКЗАМЕН ГИБДД · КАТЕГОРИЯ AB" Foreground="White" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Неофициальный учебный тренажёр" Foreground="#C9DCE9" />
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding AccountCaption}" Foreground="White" TextAlignment="Right" />
            <TextBlock Text="{Binding DeviceCaption}" Foreground="#C9DCE9" TextAlignment="Right" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="36">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="34">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Новый экзамен" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="Программа учтёт прошлые ошибки и чаще выберет сложные для кандидата тематические блоки, сохранив небольшую долю случайных вопросов."
                       TextWrapping="Wrap" FontSize="19" LineHeight="28" Foreground="{StaticResource Muted}" Margin="0,12,0,26" />
            <StackPanel Grid.Row="2">
              <TextBlock Text="Имя кандидата на этом устройстве" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBox Text="{Binding CandidateName, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" />
              <Border Background="#EDF8F6" BorderBrush="{StaticResource Teal}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,24,0,0">
                <TextBlock Text="20 вопросов · 20 минут · дополнительные вопросы по официальным правилам" TextWrapping="Wrap" FontSize="18" />
              </Border>
            </StackPanel>
            <Button Grid.Row="3" Content="ПОДГОТОВИТЬ ЭКЗАМЕН" Command="{Binding PrepareExamCommand}"
                    Style="{StaticResource PrimaryButton}" FontSize="20" Margin="0,28,0,0" />
          </Grid>
        </Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="26">
              <StackPanel>
                <TextBlock Text="Прогресс" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="{Binding HomeStatistics}" TextWrapping="Wrap" LineHeight="25" Margin="0,14,0,0" />
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="26" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="Связь устройств и Telegram" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CloudStatus}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" Margin="0,10,0,0" />
                <TextBlock Text="Подключённые устройства" FontWeight="SemiBold" Margin="0,16,0,0" />
                <TextBlock Text="{Binding ConnectedDevicesStatus}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
                <ItemsControl ItemsSource="{Binding ConnectedDevices}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastActivity}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,3,0,0" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="{Binding ActionCaption}"
                                  Command="{Binding DataContext.RevokeDeviceCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  CommandParameter="{Binding}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <WrapPanel Margin="0,16,0,0">
                  <Button Content="Подключить новый телефон" Command="{Binding ConnectNewPhoneCommand}" Margin="0,0,10,0" />
                  <Button Content="Подключить Telegram" Command="{Binding ConnectTelegramCommand}" Margin="0,0,10,0" />
                  <Button Content="Обновить список" Command="{Binding RefreshDevicesCommand}" />
                </WrapPanel>
                <WrapPanel Margin="0,10,0,0">
                  <Button Content="Повторить синхронизацию" Command="{Binding SyncNowCommand}" Margin="0,0,10,0" />
                  <Button Content="Сбросить синхронизацию" Command="{Binding ResetSynchronizationCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="26" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="Обновления" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button Content="Проверить" Command="{Binding CheckUpdatesCommand}" Margin="0,0,10,0" />
                  <Button Content="Установить" Command="{Binding InstallUpdateCommand}" Style="{StaticResource TealButton}"
                          Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Border Grid.Row="2" Background="#E6EAED" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,10">
        <Grid>
          <TextBlock Text="800 вопросов · 40 билетов · 548 JPEG-изображений · версия 2.0.2" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Закрыть программу" Command="{Binding ExitCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- Ready -->
    <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Ready}">
      <Border Background="{StaticResource Navy}" Height="88" VerticalAlignment="Top" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="820">
        <TextBlock Text="{Binding ReadyTitle}" FontSize="38" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Text="{Binding ReadyDetails}" FontSize="20" LineHeight="31" TextWrapping="Wrap" TextAlignment="Center" Margin="0,24,0,34" />
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="20" Margin="0,0,0,26">
          <TextBlock Text="После нажатия кнопки начнётся отсчёт времени. Все 20 номеров вопросов будут доступны одновременно для свободной навигации." TextWrapping="Wrap" TextAlignment="Center" />
        </Border>
        <Button Content="НАЧАТЬ ЭКЗАМЕН" Command="{Binding BeginExamCommand}" Style="{StaticResource TealButton}" Width="360" FontSize="21" />
        <Button Content="Вернуться" Command="{Binding ReturnHomeCommand}" Width="240" Margin="0,14,0,0" />
      </StackPanel>
    </Grid>

    <!-- Exam -->
    <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Exam}">
      <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="86"/></Grid.RowDefinitions>
      <Border Background="{StaticResource Navy}" Padding="26,10">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding StageCaption}" Foreground="White" FontSize="23" FontWeight="Bold" />
            <TextBlock Text="{Binding CandidateName}" Foreground="#C9DCE9" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="ОСТАЛОСЬ ВРЕМЕНИ" Foreground="#C9DCE9" FontSize="13" TextAlignment="Center" />
            <TextBlock Text="{Binding RemainingTime}" Foreground="{StaticResource Warning}" FontSize="35" FontWeight="Bold" TextAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock Text="{Binding QuestionCounter}" Foreground="White" FontSize="19" TextAlignment="Right" />
            <TextBlock Text="{Binding DeviceCaption}" Foreground="#C9DCE9" TextAlignment="Right" />
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Background="#E6EAED" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
        <ItemsControl ItemsSource="{Binding QuestionNavigation}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Number}" Command="{Binding DataContext.NavigateQuestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding Index}" Background="{Binding Background}" Foreground="{Binding Foreground}"
                      BorderBrush="{Binding Border}" FontWeight="SemiBold" Margin="3" Padding="6" MinWidth="0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
      <Grid Grid.Row="2" Margin="24,20">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="26">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding QuestionTicketCaption}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Text="{Binding QuestionText}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="32" Margin="0,13,0,16" />
            <Image Grid.Row="2" Source="{Binding CurrentImage}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="{Binding HasQuestionImage, Converter={StaticResource BoolVisibility}}" />
          </Grid>
        </Border>
        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="22">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding AnswerChoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.SelectAnswerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding Number}" Background="{Binding Background}" BorderBrush="{Binding Border}"
                          IsEnabled="{Binding IsEnabled}" HorizontalContentAlignment="Left" Margin="0,0,0,12" Padding="15,13">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Width="28" Height="28" BorderBrush="{StaticResource Navy}" BorderThickness="1" CornerRadius="14" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Number}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="18" LineHeight="26" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
      <Border Grid.Row="3" Background="#E6EAED" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
        <Grid>
          <Button Content="← Предыдущий" Width="180" HorizontalAlignment="Left" Click="PreviousQuestion_Click" />
          <Button Content="ПОДТВЕРДИТЬ ОТВЕТ" Command="{Binding ConfirmAnswerCommand}" IsEnabled="{Binding CanConfirm}"
                  Style="{StaticResource PrimaryButton}" Width="310" HorizontalAlignment="Center" />
          <Button Content="Следующий →" Width="180" HorizontalAlignment="Right" Click="NextQuestion_Click" />
        </Grid>
      </Border>
    </Grid>

    <!-- Supplementary briefing -->
    <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Supplementary}">
      <Border Background="{StaticResource Navy}" Height="88" VerticalAlignment="Top" />
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="820">
        <TextBlock Text="{Binding SupplementaryTitle}" FontSize="37" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Text="{Binding SupplementaryDetails}" FontSize="21" LineHeight="31" TextWrapping="Wrap" TextAlignment="Center" Margin="0,24,0,34" />
        <Button Content="НАЧАТЬ ДОПОЛНИТЕЛЬНЫЙ БЛОК" Command="{Binding StartSupplementaryCommand}"
                Style="{StaticResource TealButton}" Width="430" FontSize="20" />
      </StackPanel>
    </Grid>

    <!-- Result -->
    <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Result}">
      <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="88"/></Grid.RowDefinitions>
      <Border Background="{Binding ResultBrush}">
        <TextBlock Text="{Binding ResultTitle}" Foreground="White" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="880">
        <TextBlock Text="{Binding ResultDetails}" FontSize="24" LineHeight="36" TextAlignment="Center" TextWrapping="Wrap" />
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="22" Margin="0,32,0,0">
          <TextBlock Text="{Binding TelegramDeliveryStatus}" TextWrapping="Wrap" TextAlignment="Center" FontSize="18" />
        </Border>
        <Button Content="РАЗОБРАТЬ ОШИБКИ" Command="{Binding ReviewErrorsCommand}" Style="{StaticResource PrimaryButton}"
                Width="320" Margin="0,28,0,0" Visibility="{Binding HasReviewErrors, Converter={StaticResource BoolVisibility}}" />
      </StackPanel>
      <Border Grid.Row="2" Background="#E6EAED" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
        <Button Content="Вернуться на главную" Command="{Binding ReturnHomeCommand}" Width="280" HorizontalAlignment="Center" />
      </Border>
    </Grid>

    <!-- Review -->
    <Grid Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Review}">
      <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="84"/></Grid.RowDefinitions>
      <Border Background="{StaticResource Navy}" Padding="26,12">
        <Grid>
          <TextBlock Text="РАЗБОР ОШИБОК" Foreground="White" FontSize="25" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ReviewPosition}" Foreground="White" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid Margin="30">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="26">
            <StackPanel>
              <TextBlock Text="{Binding ReviewHeading}" Foreground="{StaticResource Muted}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ReviewQuestionText}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="32" Margin="0,12,0,18" />
              <Image Source="{Binding ReviewImage}" Height="360" Stretch="Uniform"
                     Visibility="{Binding HasReviewImage, Converter={StaticResource BoolVisibility}}" />
              <TextBlock Text="{Binding ReviewResponseTime}" Foreground="{StaticResource Muted}" Margin="0,18,0,0" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="2">
            <Border Background="#FDECEA" BorderBrush="#B3261E" BorderThickness="1" CornerRadius="4" Padding="18">
              <StackPanel><TextBlock Text="Ответ кандидата" FontWeight="Bold"/><TextBlock Text="{Binding ReviewSelectedAnswer}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Background="#E7F4F1" BorderBrush="{StaticResource Teal}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,16,0,0">
              <StackPanel><TextBlock Text="Правильный ответ" FontWeight="Bold"/><TextBlock Text="{Binding ReviewCorrectAnswer}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
            </Border>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4" Padding="18" Margin="0,16,0,0">
              <StackPanel><TextBlock Text="Пояснение" FontWeight="Bold"/><TextBlock Text="{Binding ReviewExplanation}" TextWrapping="Wrap" LineHeight="25" Margin="0,8,0,0"/></StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" Background="#E6EAED" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
        <Grid>
          <Button Content="← Предыдущая" Command="{Binding PreviousReviewCommand}" Width="190" HorizontalAlignment="Left" />
          <Button Content="К результату" Click="BackToResult_Click" Width="210" HorizontalAlignment="Center" />
          <Button Content="Следующая →" Command="{Binding NextReviewCommand}" Width="190" HorizontalAlignment="Right" />
        </Grid>
      </Border>
    </Grid>

    <!-- Exact flat result/review surfaces from the 1.2.0 reference are kept above the modern shell. -->
    <views:ResultView Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Result}" />
    <views:ReviewErrorsView Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Review}" />
  </Grid>
</Window>
