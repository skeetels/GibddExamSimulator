<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GibddExamSimulator</RootNamespace>
    <AssemblyName>GibddExamSimulator</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\windows-app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>2.0.4</Version>
    <Product>Тренажёр АРМ кандидата в водители</Product>
    <Company>Неофициальный учебный проект</Company>
    <DeploymentPython Condition="'$(DeploymentPython)' == ''">python</DeploymentPython>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <ProjectReference Include="..\GibddExamSimulator.Core\GibddExamSimulator.Core.csproj" />
    <ProjectReference Include="..\GibddExamSimulator.Application\GibddExamSimulator.Application.csproj" />
    <ProjectReference Include="..\GibddExamSimulator.Infrastructure\GibddExamSimulator.Infrastructure.csproj" />
    <ProjectReference Include="..\GibddExamSimulator.Sync\GibddExamSimulator.Sync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Configuration\client-settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\assets\branding\logo-master-v2.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Branding\logo.png</TargetPath>
    </Content>
    <Content Include="..\..\assets\question-bank\ab\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>QuestionBank\%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="..\..\assets\question-bank\ab\images\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>QuestionBank\images\%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>
  <Target Name="ValidateProductionDeploymentConfig"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release' and '$(SkipDeploymentConfigValidation)' != 'true'">
    <Exec Command="&quot;$(DeploymentPython)&quot; &quot;$(MSBuildProjectDirectory)/../../tools/validate_deployment_config.py&quot; --config &quot;$(MSBuildProjectDirectory)/Configuration/client-settings.json&quot;" />
  </Target>
</Project>
