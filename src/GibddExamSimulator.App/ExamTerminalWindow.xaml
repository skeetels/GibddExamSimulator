<Window x:Class="GibddExamSimulator.ExamTerminalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GibddExamSimulator.Views"
        Title="Экзаменационный терминал ГИБДД"
        Background="#FF252525"
        FontFamily="Tahoma"
        FontSize="16"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="OnPreviewKeyDown"
        Closing="OnClosing">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/LegacyExamTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border Background="White" BorderBrush="#FF555555" BorderThickness="1">
    <Grid>
      <views:ExamView Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Exam}" />
      <views:SupplementaryIntroView Visibility="{Binding Page, Converter={StaticResource PageVisibility}, ConverterParameter=Supplementary}" />
    </Grid>
  </Border>
</Window>
