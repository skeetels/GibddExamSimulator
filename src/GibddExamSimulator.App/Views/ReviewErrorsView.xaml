<UserControl x:Class="GibddExamSimulator.Views.ReviewErrorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Tahoma" FontSize="16">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/LegacyExamTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Background="White">
    <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition Height="2*" MinHeight="200"/><RowDefinition Height="3*" MinHeight="280"/><RowDefinition Height="78"/></Grid.RowDefinitions>
    <Border Background="#FFE8E8E8" BorderBrush="#FF777777" BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <TextBlock Text="ПРОСМОТР ОШИБОК" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding ReviewPosition}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="30,12">
      <Border BorderBrush="#FF888888" BorderThickness="1" Background="#FFF3F3F3"
              Visibility="{Binding HasReviewImage, Converter={StaticResource BoolVisibility}}">
        <Image Source="{Binding ReviewImage}" Stretch="Uniform" Margin="8"/>
      </Border>
      <Border BorderBrush="#FFAAAAAA" BorderThickness="1" Background="#FFF5F5F5">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers><DataTrigger Binding="{Binding HasReviewImage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
          </Style>
        </Border.Style>
        <TextBlock Text="Изображение отсутствует" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF777777"/>
      </Border>
    </Grid>
    <ScrollViewer Grid.Row="2" Margin="40,8" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="{Binding ReviewHeading}" FontSize="13" Foreground="#FF555555"/>
        <TextBlock Text="{Binding ReviewQuestionText}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,18"/>
        <Border BorderBrush="#FFB00020" BorderThickness="1" Background="#FFF8E3E3" Padding="12" Margin="0,0,0,10">
          <StackPanel><TextBlock Text="Ваш ответ:" FontWeight="Bold"/><TextBlock Text="{Binding ReviewSelectedAnswer}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        </Border>
        <Border BorderBrush="#FF0C7A2A" BorderThickness="1" Background="#FFE1F2E5" Padding="12" Margin="0,0,0,10">
          <StackPanel><TextBlock Text="Правильный ответ:" FontWeight="Bold"/><TextBlock Text="{Binding ReviewCorrectAnswer}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        </Border>
        <Border BorderBrush="#FF888888" BorderThickness="1" Background="#FFF5F5F5" Padding="12">
          <StackPanel><TextBlock Text="Комментарий:" FontWeight="Bold"/><TextBlock Text="{Binding ReviewExplanation}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel>
        </Border>
        <TextBlock Text="{Binding ReviewResponseTime}" Foreground="#FF555555" Margin="0,10,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" Background="#FFF1F1F1" BorderBrush="#FFAAAAAA" BorderThickness="0,1,0,0">
      <Grid Margin="24,12">
        <Button Content="Назад к результату" Click="BackToResult_Click" Width="210"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Предыдущая" Command="{Binding PreviousReviewCommand}" Width="150" Margin="0,0,8,0"/>
          <Button Content="Следующая" Command="{Binding NextReviewCommand}" Width="150"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
