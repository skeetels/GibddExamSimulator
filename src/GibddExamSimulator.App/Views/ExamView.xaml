<UserControl x:Class="GibddExamSimulator.Views.ExamView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
  <Grid Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="58" />
      <RowDefinition Height="50" />
      <RowDefinition Height="*" />
      <RowDefinition Height="42" />
    </Grid.RowDefinitions>

    <Border Background="#FFE6E6E6" BorderBrush="#FF777777" BorderThickness="0,0,0,1">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding TerminalText}" FontWeight="Bold" VerticalAlignment="Center" FontSize="17" />
        <TextBlock Grid.Column="1" Text="{Binding CandidateText}" TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="Осталось: " FontWeight="Bold" />
          <TextBlock Text="{Binding RemainingTime}" FontWeight="Bold" FontSize="21" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Background="#FFF2F2F2">
      <TextBlock Text="{Binding StageCaption}" FontWeight="Bold" FontSize="13"
                 HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" />
      <ItemsControl ItemsSource="{Binding QuestionNavigation}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Content="{Binding Number}"
                    Command="{Binding DataContext.NavigateQuestionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding Index}"
                    Width="28" Height="28" MinHeight="0" Margin="1" Padding="0" FontSize="10"
                    Background="{Binding Background}" Foreground="{Binding Foreground}"
                    BorderBrush="{Binding Border}" FontWeight="Bold" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="ДЕМО-БАЗА — НЕ ОФИЦИАЛЬНЫЕ ВОПРОСЫ" Foreground="#FF8A5500"
                 FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Margin="0,0,18,0" Visibility="{Binding IsDemoQuestion, Converter={StaticResource BoolVisibility}}" />
    </Grid>

    <Grid Grid.Row="2">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsExamOverview}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <TextBlock Text="{Binding ExamOverviewHeaderText}" FontWeight="Bold" FontSize="15"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ItemsControl Grid.Row="1" ItemsSource="{Binding OverviewQuestions}" Margin="12,0,12,10"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="5"
                         Columns="{Binding DataContext.ExamOverviewColumnCount, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Command="{Binding DataContext.OpenOverviewQuestionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    CommandParameter="{Binding Index}" Margin="2" Padding="0" MinHeight="0"
                    Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="2"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="TileBorder" Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="TileBorder" Property="Background" Value="#FFE1EAF2" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter TargetName="TileBorder" Property="Background" Value="#FFC8D8E8" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <Grid Margin="5" ClipToBounds="True">
                <Grid.RowDefinitions><RowDefinition Height="18" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding Number, StringFormat=Вопрос {0}}" FontWeight="Bold" FontSize="11" />
                <TextBlock Text="{Binding ProgressText}" Foreground="{Binding ProgressBrush}" FontWeight="Bold"
                           FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Grid Grid.Row="1" Margin="0,2">
                  <Image Source="{Binding Image}" Stretch="Uniform"
                         Visibility="{Binding HasImage, Converter={StaticResource BoolVisibility}}" />
                  <TextBlock Text="{Binding QuestionText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                             FontSize="12" TextAlignment="Center" VerticalAlignment="Center" Margin="5">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasImage}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <TextBlock Grid.Row="2" Text="{Binding QuestionText}" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" FontSize="10" MaxHeight="34" Margin="1,1,1,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasImage}" Value="True">
                          <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Visible" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsExamOverview}" Value="True">
              <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="2.8*" MinHeight="210" />
        <RowDefinition Height="Auto" MinHeight="82" />
        <RowDefinition Height="2*" MinHeight="130" />
        <RowDefinition Height="76" />
      </Grid.RowDefinitions>
      <Grid Margin="26,10">
        <Border BorderBrush="#FF888888" BorderThickness="1" Background="#FFF3F3F3"
                Visibility="{Binding HasQuestionImage, Converter={StaticResource BoolVisibility}}">
          <Image Source="{Binding CurrentImage}" Stretch="Uniform" Margin="8" />
        </Border>
        <Border BorderBrush="#FFAAAAAA" BorderThickness="1" Background="#FFF5F5F5">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasQuestionImage}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="Изображение к вопросу отсутствует" Foreground="#FF666666"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </Grid>
      <StackPanel Grid.Row="1" Margin="38,8,38,4">
        <TextBlock Text="{Binding QuestionTitle}" FontWeight="Bold" FontSize="17" Margin="0,0,0,8" />
        <TextBlock Text="{Binding QuestionText}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
      </StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="38,2,38,4">
        <ItemsControl ItemsSource="{Binding AnswerChoices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding DisplayText}"
                      Command="{Binding DataContext.SelectAnswerCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                      CommandParameter="{Binding Number}" Background="{Binding Background}" BorderBrush="{Binding Border}"
                      IsEnabled="{Binding IsEnabled}" HorizontalContentAlignment="Left" FontSize="18"
                      MinHeight="52" Margin="0,0,0,7" Padding="16,8" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Grid Grid.Row="3" Margin="26,7">
        <Button Content="К ПЕРЕЧНЮ" Command="{Binding ReturnToOverviewCommand}" Width="175" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="◀" Command="{Binding PreviousQuestionCommand}" Width="62" Margin="0,0,12,0" />
          <Button Content="ОТВЕТИТЬ" Command="{Binding ConfirmAnswerCommand}" IsEnabled="{Binding CanConfirm}"
                  Width="230" FontWeight="Bold" Background="#FFDDEAF6" />
          <Button Content="▶" Command="{Binding NextQuestionCommand}" Width="62" Margin="12,0,0,0" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="3" Background="#FFF2F2F2" BorderBrush="#FFAAAAAA" BorderThickness="0,1,0,0">
      <Grid Margin="18,0">
        <TextBlock Text="{Binding ExamStatusMessage}" FontSize="13" VerticalAlignment="Center" />
        <TextBlock Text="Enter/пробел — открыть или подтвердить; Esc — к перечню"
                   FontSize="11" Foreground="#FF666666" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
