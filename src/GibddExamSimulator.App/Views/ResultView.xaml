<UserControl x:Class="GibddExamSimulator.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Tahoma" FontSize="16">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/LegacyExamTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Background="White">
    <Grid.RowDefinitions><RowDefinition Height="62"/><RowDefinition/><RowDefinition Height="82"/></Grid.RowDefinitions>
    <Border Background="#FFE8E8E8" BorderBrush="#FF777777" BorderThickness="0,0,0,1">
      <Grid Margin="24,0">
        <TextBlock Text="РЕЗУЛЬТАТ ЭКЗАМЕНА" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding CandidateName}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Width="760" Margin="0,35">
        <TextBlock Text="{Binding ResultTitle}" Foreground="{Binding ResultBrush}" FontSize="38" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,26"/>
        <Border BorderBrush="#FF888888" BorderThickness="1" Padding="24" Background="#FFF7F7F7">
          <TextBlock Text="{Binding ResultDetails}" FontSize="18" LineHeight="29" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
        <Border Background="#FFEAF1F7" BorderBrush="#FF6685A3" BorderThickness="1" Padding="12" Margin="0,18,0,0">
          <TextBlock Text="{Binding TelegramDeliveryStatus}" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
        <Border Background="#FFEAF3E5" BorderBrush="#FF6B8E5D" BorderThickness="1" Padding="12" Margin="0,12,0,0">
          <TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" TextAlignment="Center"/>
        </Border>
        <WrapPanel HorizontalAlignment="Center" Margin="0,24,0,0">
          <Button Content="Просмотреть ошибки" Command="{Binding ReviewErrorsCommand}" Width="205" Margin="5"
                  Visibility="{Binding HasReviewErrors, Converter={StaticResource BoolVisibility}}"/>
          <Button Content="Новый экзамен" Command="{Binding PrepareExamCommand}" Width="170" Margin="5"/>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#FFF1F1F1" BorderBrush="#FFAAAAAA" BorderThickness="0,1,0,0">
      <Button Content="В главное меню" Command="{Binding ReturnHomeCommand}" Width="210" HorizontalAlignment="Right" Margin="24,13"/>
    </Border>
  </Grid>
</UserControl>
