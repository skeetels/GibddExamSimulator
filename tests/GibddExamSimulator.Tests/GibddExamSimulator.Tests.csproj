<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>GibddExamSimulator.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GibddExamSimulator.Core\GibddExamSimulator.Core.csproj" />
    <ProjectReference Include="..\..\src\GibddExamSimulator.Application\GibddExamSimulator.Application.csproj" />
    <ProjectReference Include="..\..\src\GibddExamSimulator.Infrastructure\GibddExamSimulator.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\GibddExamSimulator.Sync\GibddExamSimulator.Sync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\GibddExamSimulator.App\ExamTerminalWindow.xaml"
             Link="DesktopContract\ExamTerminalWindow.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\GibddExamSimulator.App\Views\ExamView.xaml"
             Link="DesktopContract\ExamView.xaml"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\GibddExamSimulator.App\Resources\LegacyExamTheme.xaml"
             Link="DesktopContract\LegacyExamTheme.xaml"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
